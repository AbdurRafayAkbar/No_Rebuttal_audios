# Copy to .env and fill in. Never commit .env.
# MySQL server that holds the call data. The app only runs SELECT there
# (every session is forced READ ONLY). Never change anything on that server.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=call_data

# Deepgram
DEEPGRAM_API_KEY=

# LLM judge
LLM_PROVIDER=openai_compatible
LLM_MODEL=/models/gpt-oss-120b
# Base URL of the OpenAI-compatible server, e.g. http://<host>:<port>/v1
LLM_ENDPOINT=
LLM_API_KEY=

# Allowed URL prefixes (URLs from the DB must start with these)
AUDIO_URL_PREFIX=https://hel1.your-objectstorage.com/sd-bucket/
LOG_URL_PREFIX=https://hel1.your-objectstorage.com/sd-logs/

# Pipeline
# One "day" of calls = one shift in RUN_TZ: SHIFT_START on the date to SHIFT_END
# (next day when SHIFT_END <= SHIFT_START). Example: Monday 18:00 to Tuesday 04:00 PKT.
RUN_TZ=Asia/Karachi
SHIFT_START=18:00
SHIFT_END=04:00
# Parallel log downloads
WORKERS=16
# Local folder for our own database (SQLite), reports and caches
DATA_DIR=data
