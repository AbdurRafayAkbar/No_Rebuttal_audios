# Copy to .env and fill in. Never commit .env.
# MySQL server that holds the call data (existing `call_records` table is read-only for us). Use a read-only user, never root.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=call_data

# Deepgram
DEEPGRAM_API_KEY=

# LLM judge
LLM_PROVIDER=openai_compatible
LLM_MODEL=/models/gpt-oss-120b
# Base URL of the OpenAI-compatible server, e.g. http://<host>:<port>/v1
LLM_ENDPOINT=
LLM_API_KEY=

# Paths
AUDIO_URL_PREFIX=https://hel1.your-objectstorage.com/sd-bucket/
